<Window x:Class="AudioCompressor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:vm="clr-namespace:AudioCompressor.UI.ViewModels"
        Title="{Binding WindowTitle}"
        Height="750" Width="1100" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable"
        Background="#1E1E24"
        Foreground="#FFFFFF">

    <Window.Resources>
        <!-- Palette -->
        <Color x:Key="BgColor">#1E1E24</Color>
        <Color x:Key="CardColor">#2A2A32</Color>
        <Color x:Key="AccentColor">#007ACC</Color>
        <Color x:Key="AccentAlt">#00ADB5</Color>
        <Color x:Key="MutedText">#B9BEC6</Color>

        <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentAltBrush" Color="{StaticResource AccentAlt}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedText}"/>

        <!-- Typography -->
        <FontFamily x:Key="UiFont">Segoe UI Semibold</FontFamily>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="12" Direction="270" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label styles -->
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SubHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="PropValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Button style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3A3A44"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ActionButton style (existing) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- SectionBorder (existing) -->
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT STACK (File input & properties) -->
        <StackPanel Grid.Column="0" Orientation="Vertical">

            <!-- ═══════ DROP ZONE ═══════ -->
            <Border AllowDrop="True"
                    PreviewDragOver="DropZone_PreviewDragOver" Drop="DropZone_Drop" Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SectionBorder}">
                        <Setter Property="BorderBrush" Value="#6699FF"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Background" Value="#F0F4FF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFileLoaded}" Value="True">
                                <Setter Property="Background" Value="#F0FFF0"/>
                                <Setter Property="BorderBrush" Value="#66CC66"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="&#x1F4C2;  Drag &amp; Drop .WAV file here"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                FontSize="16" Foreground="#6699FF" Opacity="0.6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFileLoaded}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding DropZoneText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="18" Foreground="#444" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFileLoaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Row="1" Content="📁 Browse Files" Style="{StaticResource PrimaryButton}" 
        Click="DropZone_Browse_Click" 
       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- ═══════ PROPERTIES + SETTINGS ═══════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="File Properties" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="File:" Style="{StaticResource PropLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileName}" Style="{StaticResource PropValue}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Size:" Style="{StaticResource PropLabel}" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FileSize}" Style="{StaticResource PropValue}" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Duration:" Style="{StaticResource PropLabel}" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource PropValue}" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Sample Rate:" Style="{StaticResource PropLabel}" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SampleRate}" Style="{StaticResource PropValue}" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Channels:" Style="{StaticResource PropLabel}" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Channels}" Style="{StaticResource PropValue}" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Bit Rate:" Style="{StaticResource PropLabel}" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BitRate}" Style="{StaticResource PropValue}" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Encoding:" Style="{StaticResource PropLabel}" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Encoding}" Style="{StaticResource PropValue}" Margin="0,3,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Output Info Card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
				<StackPanel>
                    <StackPanel>
                        <TextBlock Text="Output Info" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubHeading}" TextWrapping="Wrap"/>
                    </StackPanel>
				    <StackPanel Margin="0,10,0,0">
					    <TextBlock Text="Compression Quality:" FontWeight="Bold" Foreground="Gray"/>
					    <TextBlock Text="{Binding SnrResult}" FontSize="16" Foreground="Green"/>
				    </StackPanel>
				</StackPanel>
            </Border>

            <!-- Compressed Files Management Card -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Compressed Files" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Files in compressed_output:" Style="{StaticResource SubHeading}"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCompressedFilesCommand}" Margin="6,0,0,0"/>

                        <ListBox Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding CompressedFiles}" SelectedItem="{Binding SelectedCompressedFile}" FontFamily="Consolas" FontSize="12" Background="#151518" Foreground="#E8E8E8" BorderThickness="0"/>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Open Folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenCompressedFolderCommand}" Margin="0,0,6,0"/>
                            <Button Content="Show Info" Style="{StaticResource SecondaryButton}" Command="{Binding ShowCompressedMetadataCommand}" Margin="0,0,6,0"/>
                            <Button Content="Delete" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCompressedCommand}" IsEnabled="{Binding HasSelectedCompressedFile}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- GAP -->
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#00000000" ShowsPreview="True"/>

        <!-- RIGHT: Settings, Controls, Charts -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Controls Row -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="▶ Play" Style="{StaticResource ActionButton}"
                            Command="{Binding PlayCommand}"
                            IsEnabled="{Binding IsFileLoaded}"
                            Background="#4CAF50" Foreground="White"
                            Grid.Column="0"/>
                    <Button Content="■ Stop" Style="{StaticResource ActionButton}"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding IsPlaying}"
                            Background="#F44336" Foreground="White"
                            Grid.Column="1"/>

                    <Button Content="⚙ Compress" Style="{StaticResource ActionButton}"
                            Command="{Binding DoCompressCommand}"
                            IsEnabled="{Binding CanCompress}"
                            Background="#1976D2" Foreground="White" FontWeight="Bold"
                            Grid.Column="4" Margin="12,3,0,3"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Column="2" Grid.ColumnSpan="2" Margin="12,0,0,0">
                        <Button Content="↺ Reset" Style="{StaticResource ActionButton}"
                                Command="{Binding ResetCommand}"
                                IsEnabled="{Binding IsFileLoaded}"
                                Background="#FF9800" Foreground="White" Margin="0,0,6,0"/>
                        <Button Content="🗑️ Remove File" Style="{StaticResource ActionButton}"
                                Command="{Binding RemoveFileCommand}"
                                IsEnabled="{Binding IsFileLoaded}"
                                Background="#9E9E9E" Foreground="White" Margin="0,0,6,0"/>
                        <Button Content="✕ Cancel" Style="{StaticResource ActionButton}"
                                Command="{Binding CancelCompressCommand}"
                                IsEnabled="{Binding IsCompressing}"
                                Background="#9E9E9E" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Settings card -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Configuration" Style="{StaticResource Heading}" Margin="0,0,0,10"/>
                        <TextBlock Text="Algorithm" Style="{StaticResource PropLabel}"/>
                        <ComboBox ItemsSource="{Binding AlgorithmOptions}" SelectedItem="{Binding SelectedAlgorithmItem}" IsEnabled="{Binding CanCompress}" Margin="0,6,0,12"/>

                        <TextBlock Text="Quantization" Style="{StaticResource PropLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,12" VerticalAlignment="Center">
                            <Slider Minimum="2" Maximum="16" Value="{Binding TargetBits}" IsEnabled="{Binding CanCompress}" Width="160"/>
                            <TextBlock Text="{Binding TargetBits, StringFormat='{}{0} bits'}" Style="{StaticResource PropValue}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Law (μ/A)" Style="{StaticResource PropLabel}"/>
                        <ComboBox ItemsSource="{Binding LawOptions}" SelectedItem="{Binding SelectedLawItem}" IsEnabled="{Binding CanCompress}" Margin="0,6,0,12"/>

                        <!-- Target Sample Rate control -->
                        <TextBlock Text="Target Sample Rate (Hz)" Style="{StaticResource PropLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                            <ComboBox Width="160" IsEditable="False" Margin="0,0,8,0" SelectedValue="{Binding TargetSampleRate, Mode=TwoWay}">
                                <ComboBoxItem Content="8000"/>
                                <ComboBoxItem Content="11025"/>
                                <ComboBoxItem Content="22050"/>
                                <ComboBoxItem Content="32000"/>
                                <ComboBoxItem Content="44100"/>
                                <ComboBoxItem Content="48000"/>
                                <ComboBoxItem Content="96000"/>
                            </ComboBox>
                            <TextBox Width="100" Text="{Binding TargetSampleRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Advanced Parameters" Style="{StaticResource Heading}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mu (μ):" Style="{StaticResource PropLabel}" VerticalAlignment="Center" Margin="0,6,8,6"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="500" Value="{Binding MuLawMu}" IsEnabled="{Binding CanCompress}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MuLawMu, StringFormat='{}{0:F0}'}" Style="{StaticResource PropValue}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="A-law (A):" Style="{StaticResource PropLabel}" VerticalAlignment="Center" Margin="0,6,8,6"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="200" Value="{Binding ALawA}" IsEnabled="{Binding CanCompress}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ALawA, StringFormat='{}{0:F1}'}" Style="{StaticResource PropValue}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Step Size:" Style="{StaticResource PropLabel}" VerticalAlignment="Center" Margin="0,6,8,6"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StepSize}" Height="30" IsEnabled="{Binding CanCompress}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding OriginalBitsLabel}" Style="{StaticResource SubHeading}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>

                        <CheckBox Content="Adaptive Delta Mod" IsChecked="{Binding UseAdaptiveDelta}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════ CHART (ScottPlot) ═══════ -->
            <Border Grid.Row="2" Style="{StaticResource SectionBorder}" Padding="4" Margin="4,4,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Real-Time Monitoring"
                               FontSize="14" FontWeight="Bold" Foreground="#333" Margin="2,0,0,2"/>
                    <sp:WpfPlot x:Name="Chart" Grid.Row="1"/>
                </Grid>
            </Border>

            <!-- ═══════ PROGRESS + INFO ═══════ -->
            <Border Grid.Row="3" Style="{StaticResource SectionBorder}" Padding="8" Margin="4,4,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding ProgressValue}" Height="20" Maximum="1"
                                     Margin="0,0,90,0" Foreground="#1976D2" ValueChanged="ProgressBar_ValueChanged" Grid.ColumnSpan="4"/>
                        <TextBlock Grid.Column="1" Text="{Binding CompressionStatus}" Width="90"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding SpeedDisplay}" Width="150"
                                   FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding RatioDisplay}" Width="180"
                                   FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="#666"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══════ STATUS BAR ═══════ -->
            <Border Grid.Row="4" Margin="4,2,4,0" Background="#F5F5F5"
                    BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="{Binding StatusMessage}" Margin="6,0"
                           VerticalAlignment="Center" FontSize="12" Foreground="#666"/>
            </Border>
        </Grid>
    </Grid>
</Window>

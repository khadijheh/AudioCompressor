<Window x:Class="AudioCompressor.UI.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compression Report" Height="460" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="RLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>
    <Border Margin="16" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Padding="20" Background="#FAFAFA">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Compression Complete"
                       FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,16"/>
            <Grid Grid.Row="1" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="File:" Style="{StaticResource RLabel}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileName}" Style="{StaticResource RValue}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Original size:" Style="{StaticResource RLabel}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OriginalSize}" Style="{StaticResource RValue}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Compressed data:" Style="{StaticResource RLabel}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CompressedSize}" Style="{StaticResource RValue}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Output WAV:" Style="{StaticResource RLabel}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DecompressedWavSize}" Style="{StaticResource RValue}" Margin="0,6,0,0"/>
                <Rectangle Grid.Row="4" Grid.ColumnSpan="2" Height="1" Fill="#DDD" Margin="0,8"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Compression ratio:" Style="{StaticResource RLabel}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CompressionRatio}" Style="{StaticResource RValue}" Margin="0,6,0,0" Foreground="#1976D2"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Savings:" Style="{StaticResource RLabel}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SavingsPercent}" Style="{StaticResource RValue}" Margin="0,6,0,0" Foreground="#388E3C" FontWeight="Bold"/>
                <Rectangle Grid.Row="7" Grid.ColumnSpan="2" Height="1" Fill="#DDD" Margin="0,8"/>
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Algorithm:" Style="{StaticResource RLabel}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Algorithm}" Style="{StaticResource RValue}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Settings:" Style="{StaticResource RLabel}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Settings}" Style="{StaticResource RValue}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="10" Grid.Column="0" Text="Time:" Style="{StaticResource RLabel}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Elapsed}" Style="{StaticResource RValue}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="11" Grid.Column="0" Text="Output:" Style="{StaticResource RLabel}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding OutputPath}" Style="{StaticResource RValue}" Margin="0,6,0,0" TextWrapping="WrapWithOverflow"/>
            </Grid>
            <Button Grid.Row="2" Content="OK" Width="100" Height="32" Margin="0,12,0,0"
                    HorizontalAlignment="Center" Cursor="Hand"
                    Click="Ok_Click" Background="#1976D2" Foreground="White"
                    FontWeight="SemiBold"/>
        </Grid>
    </Border>
</Window>
